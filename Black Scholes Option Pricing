#Black Scholes Options Pricing
import numpy as np
import matplotlib.pyplot as plt
import pandas as pd
from scipy.stats import norm

S = 100
K = 100
r = 0.05
sigma = 0.20
T = 1

d1 = (np.log(S/K)+(r+0.5*(sigma**2))*T) / (sigma*(np.sqrt(T)))
d2 = d1 - sigma*np.sqrt(T)

#Call options pricing
c = S * norm.cdf(d1) - (K*np.exp(-r*T) * norm.cdf(d2))

#Put options pricing
p = K * np.exp(-r*T) * norm.cdf(-d2) - S* norm.cdf(-d1)

if abs((c-p)-(S-K*np.exp(-r*T)))< 0.00001:
  print("Put Call parity holds")
else:
  print("Put Call parity does not hold")


#Varying the stock price
S = [50,60,70,80,90,100,110,120,130,140,150]
C = []
P = []
for i in S:
  d1 = (np.log(i/K)+(r+0.5*(sigma**2))*T) / (sigma*(np.sqrt(T)))
  d2 = d1 - sigma*np.sqrt(T)
  c = i * norm.cdf(d1) - (K*np.exp(-r*T) * norm.cdf(d2))
  p = K * np.exp(-r*T) * norm.cdf(-d2) - i* norm.cdf(-d1)
  C.append(round(float(c), 4))
  P.append(round(float(p), 4))

stock_sim_df = pd.DataFrame(
    {"S_t":S,
     "Call":C,
     "Put":P
     })

print(stock_sim_df)

plt.title("Options vs stock price")
plt.axvline(x = K, label = "Strike Price")
plt.plot(stock_sim_df['S_t'], stock_sim_df['Call'], label = 'Call')
plt.plot(stock_sim_df['S_t'], stock_sim_df['Put'], label = 'Put')
plt.xlabel("Stock Price")
plt.ylabel("Options Price")
plt.legend()
plt.show()



