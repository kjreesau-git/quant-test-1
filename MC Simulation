import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

#Price Path simulation

#Inputs
S_0 = 100
T = 252
mean = 0.0003
sigma = 0.015

#Simulation of one price path across 252 trading days

returns = np.random.normal(mean, sigma, T)
prices = np.cumprod(1+returns)*S_0
prices = np.insert(prices, 0, S_0)

S_T = prices[-1]
#print("Final Price:", S_T)

total_return = ((S_T-S_0)/S_0)*100
#print("Total Return:", total_return, "%")

annualized_vol = np.std(returns)*np.sqrt(T)
print("Annualized Vol:", annualized_vol)

running_peak = np.maximum.accumulate(prices)
#print("Running Peak:", running_peak)

drawdown = ((prices/running_peak)-1)*100
#print("Drawdown at each price:", drawdown)
print("Max drawdown:", np.min(drawdown))

#plots
plt.plot(prices)
plt.title("Price path")
plt.xlabel("Trading Days")
plt.show()

plt.hist(returns, bins = 20)
plt.title("Histogram of returns")
plt.xlabel("Returns")
plt.show()

plt.plot(drawdown)
plt.title("Drawdown path")
plt.xlabel("Trading Days")
plt.ylabel("%")
plt.show()



