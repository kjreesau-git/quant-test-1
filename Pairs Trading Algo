# Set up the regression
Y = log_prices['EURUSD=X']
X = log_prices['GBPUSD=X']

# Fit Y = alpha + beta*X
model = LinearRegression()
model.fit(X.values.reshape(-1, 1), Y)

alpha = model.intercept_
beta = model.coef_[0]
r_squared = model.score(X.values.reshape(-1, 1), Y)

# Construct the residual spread
spread = Y - (alpha + beta * X)

plt.plot(spread)
plt.xlabel("Date")
plt.ylabel("Spread")
plt.title("EURUSD - GBPUSD spread over time")
plt.show()

#Standardising the spread
rolling_mean = spread.rolling(60).mean()
rolling_std = spread.rolling(60).std()

spread_z = (spread - rolling_mean) / rolling_std

#Trading strategy
strategy = pd.DataFrame(index=spread_z.index)

strategy["spread"] = spread
strategy["z_score"] = spread_z
strategy["signal"] = "Hold"

strategy.loc[strategy["z_score"] > 2, "signal"] = "Sell"
strategy.loc[strategy["z_score"] < -2, "signal"] = "Buy"
strategy.loc[strategy["z_score"].abs() < 0.1, "signal"] = "Exit"
print(strategy.tail(20))

strategy["position"] = np.nan

strategy.loc[strategy["signal"] == "Buy", "position"] = 1
strategy.loc[strategy["signal"] == "Sell", "position"] = -1
strategy.loc[strategy["signal"] == "Exit", "position"] = 0
strategy["position"] = strategy["position"].ffill().fillna(0)
strategy['position'] = strategy["position"].shift(1)
#Strategy returns based on the spread between EURUSD and GBPUSD
pair_return = np.log(raw_prices['EURUSD=X']).diff() - beta * np.log(raw_prices['GBPUSD=X']).diff()
strategy['strategy_return'] = strategy['position'] *pair_return
print(strategy.tail())


#Backtest evaluation

#Creating an equity column for the cum return plot

strategy['cum_returns'] = (1 + strategy["strategy_return"].fillna(0)).cumprod()

#Total returns
total_return = strategy["cum_returns"].iloc[-1] - 1
print("total_return:", total_return)
annualized_vol = np.std(strategy['strategy_return']) * np.sqrt(252)
print("annualized_vol:", annualized_vol)
sharpe = (strategy['strategy_return'].mean() / strategy['strategy_return'].std()) * np.sqrt(252)
print("sharpe:", sharpe)
drawdown = strategy['cum_returns']/strategy['cum_returns'].cummax() - 1
max_drawdown = drawdown.min()
print("max_drawdown:", max_drawdown)


#Total trade counts
trade_count = (strategy['position'].diff().abs()>0).sum()
print(trade_count)

#plotting the curve
plt.figure(figsize = (15,6))
plt.plot(strategy['cum_returns'])
plt.title("Pairs trading strategy return curve")
plt.xlabel("Date")
plt.ylabel("Returns")
plt.show()

