from sklearn.linear_model import LinearRegression
from statsmodels.tsa.stattools import adfuller
from statsmodels.tsa.stattools import coint

pairs = [('AUDUSD=X', 'NZDUSD=X'),('EURUSD=X', 'GBPUSD=X'),('AUDUSD=X', 'GBPUSD=X'),('GBPUSD=X', 'NZDUSD=X'),('EURUSD=X', 'NZDUSD=X')]

for ticker_1, ticker_2 in pairs:

    print("-" * 80)
    print("Regression:", ticker_1, "-", ticker_2)

    # Set up the regression
    Y = log_prices[ticker_1]
    X = log_prices[ticker_2]

    # Fit Y = alpha + beta*X
    model = LinearRegression()
    model.fit(X.values.reshape(-1, 1), Y)

    alpha = model.intercept_
    beta = model.coef_[0]
    r_squared = model.score(X.values.reshape(-1, 1), Y)

    # Construct the residual spread
    spread = Y - (alpha + beta * X)

    # Test the spread for stationarity
    adf_results = adfuller(spread)

    print("Alpha:", alpha)
    print("Beta:", beta)
    print("R²:", r_squared)
    print("Spread ADF statistic:", adf_results[0])
    print("Spread ADF p-value:", adf_results[1])

