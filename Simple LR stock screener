import pandas as pd
from sklearn.preprocessing import StandardScaler

data = {
    "ticker": ["AAA", "BBB", "CCC", "DDD", "EEE", "FFF", "GGG", "HHH"],
    "pe_ratio": [12, 28, 18, 35, 10, 22, 15, 40],
    "roe": [0.18, 0.12, 0.21, 0.08, 0.25, 0.16, 0.20, 0.07],
    "revenue_growth": [0.10, 0.18, 0.07, 0.25, 0.05, 0.12, 0.09, 0.30],
    "momentum_6m": [0.14, 0.22, -0.05, 0.30, 0.02, 0.11, 0.16, 0.35],
    "volatility": [0.20, 0.32, 0.18, 0.40, 0.15, 0.24, 0.21, 0.45],
    "next_3m_return": [0.08, 0.04, 0.10, -0.02, 0.07, 0.06, 0.09, -0.05]
}

df = pd.DataFrame(data)

# Inspect data
print(df.describe())

# Check missing values
print(df.isnull().sum())

# Check duplicates
print(df.duplicated().sum())

# Raw factor columns
factor_columns = [
    "pe_ratio",
    "roe",
    "revenue_growth",
    "momentum_6m",
    "volatility"
]

# Standardise raw factors
scaler = StandardScaler()

scaled = scaler.fit_transform(df[factor_columns])

df[["value_score",
        "quality_score",
        "growth_score",
        "momentum_score",
        "risk_score"
    ]
] = scaled

# Lower P/E is better, so reverse the sign
df["value_score"] = -df["value_score"]

# Lower volatility is better, so reverse the sign
df["risk_score"] = -df["risk_score"]

# Equal-weight composite score
score_columns = [
    "value_score",
    "quality_score",
    "growth_score",
    "momentum_score",
    "risk_score"
]

df["composite_score"] = df[score_columns].mean(axis=1)

# Sort stocks from best to worst
df = df.sort_values("composite_score", ascending=False)

print(df)

# Top 3 stocks
print(df.head(3))

#Measuring the comp score vs the next_3m_return

correlation = df['composite_score'].corr(df['next_3m_return'])
print(f"Correlation between composite score and next 3M return: {correlation}")

#Simple Linear Regression Model
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error
import numpy as np


X = df[['pe_ratio', 'roe', 'revenue_growth', 'momentum_6m', 'volatility']]
y = df['next_3m_return']

model = LinearRegression()
model.fit(X,y)

predictions = model.predict(X)
df['predicted_return'] = predictions

rmse = np.sqrt(mean_squared_error(df['next_3m_return'], df['predicted_return']))
print(f"RMSE: {rmse}")

coefficients = pd.DataFrame({
    "feature": X.columns,
    "coefficient": model.coef_
})

print(coefficients)

print(f"Intercept: {model.intercept_:.4f}")
