import pandas as pd

data = {
    "ticker": ["AAA", "BBB", "CCC", "DDD", "EEE", "FFF"],
    "sector": ["Technology", "Technology", "Financials", "Healthcare", "Industrials", "Financials"],
    "weight": [0.20, 0.15, 0.18, 0.17, 0.12, 0.18],
    "beta": [1.30, 1.10, 0.90, 0.70, 1.00, 0.85],
    "volatility": [0.28, 0.22, 0.18, 0.16, 0.20, 0.19],
    "return_1m": [0.06, -0.02, 0.03, 0.01, -0.01, 0.04]
}

df = pd.DataFrame(data)

# Check portfolio weights
if abs(df["weight"].sum() - 1) < 1e-8:
    print("Portfolio weights are valid")
else:
    print("Portfolio weights are not valid")

# Calculate stock-level return contribution
df["return_contribution"] = df["weight"] * df["return_1m"]

# Calculate portfolio return
portfolio_return_1m = df["return_contribution"].sum()
print(f"1-month portfolio return: {portfolio_return_1m:.2%}")

# Calculate portfolio beta
df["beta_contribution"] = df["weight"] * df["beta"]
portfolio_beta = df["beta_contribution"].sum()
print(f"Portfolio beta: {portfolio_beta:.2f}")

# Calculate sector exposure
sector_exposure = df.groupby("sector")["weight"].sum()

print("\nSector exposure:")
print(sector_exposure)

largest_sector = sector_exposure.idxmax()
print(f"\nLargest sector exposure: {largest_sector} ({sector_exposure.max():.2%})")

# Show stock return contributions
print("\nStock return contributions:")
print(df[["ticker", "return_contribution"]])

# Scenario assumptions
df.loc[df["sector"] == "Technology", "scenario_return"] = -0.12
df.loc[df["sector"] == "Financials", "scenario_return"] = -0.05
df.loc[df["sector"] == "Healthcare", "scenario_return"] = -0.02
df.loc[df["sector"] == "Industrials", "scenario_return"] = -0.07

# Calculate stock-level scenario contribution
df["scenario_contribution"] = df["weight"] * df["scenario_return"]

# Calculate total portfolio scenario return
portfolio_scenario_return = df["scenario_contribution"].sum()
print(f"\nPortfolio scenario return/loss: {portfolio_scenario_return:.2%}")

# Calculate scenario contribution by sector
sector_scenario = df.groupby("sector")["scenario_contribution"].sum()

print("\nScenario contribution by sector:")
print(sector_scenario)

# Identify sector causing the largest loss
largest_loss_sector = sector_scenario.idxmin()
print(f"\nLargest loss sector: {largest_loss_sector}")

# Scenario summary
summary_df = df[
    ["ticker", "sector", "weight", "scenario_return", "scenario_contribution"]
]

print("\nScenario summary:")
print(summary_df)
